#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
	local enabled config_file
	config_load qwdtt
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get config_file main config /etc/qwdtt/config.json
	[ -r "$config_file" ] || {
		logger -t qwdtt "Config not found: $config_file"
		return 1
	}

	procd_open_instance
	procd_set_param command /usr/bin/qwdtt-client -config "$config_file"
	procd_set_param respawn 10 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="65535 65535"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger qwdtt
	procd_add_interface_trigger "interface.*" wan /etc/init.d/qwdtt restart
}
